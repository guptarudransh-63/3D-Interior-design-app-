# ==============================================================================
# SpaceCraft Client Environment Configuration (Vercel)
# ==============================================================================
# Set this to your live Render backend URL when deploying client on Vercel:
# (e.g., https://spacecraft-api.onrender.com)
#
# If left empty in local development, Vite proxies requests from localhost:5173 to
# the local server on localhost:5001 automatically.
VITE_API_URL=https://<your-render-service-name>.onrender.com
