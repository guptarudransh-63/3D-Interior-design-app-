# ==============================================================================
# SpaceCraft Server Environment Configuration (Render)
# ==============================================================================
# Port provided automatically by Render in production, or defaults to 5001 locally:
PORT=5001
NODE_ENV=production

# MongoDB Atlas Connection URI:
# Replace <username>, <password>, and cluster details with your MongoDB Atlas cluster:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/spacecraft?retryWrites=true&w=majority

# JWT Authentication Secret Key (use a long, secure random string):
JWT_SECRET=your_jwt_secret_key_here

# Client URL for CORS:
# Set to your deployed Vercel URL (e.g. https://your-app.vercel.app).
# Multiple origins can be comma-separated. Any *.vercel.app domain is also auto-allowed.
CLIENT_URL=https://<your-vercel-app>.vercel.app,http://localhost:5173
